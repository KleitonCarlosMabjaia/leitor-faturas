# Copie este ficheiro para .env e preencha os valores.
# O .env está no .gitignore: nunca vai para o repositório.

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo do Claude usado para ler as faturas
MODELO_IA=claude-opus-5-5

# Esforço de raciocínio: low, medium, high (low chega para faturas)
ESFORCO_IA=low

# Base de dados (por omissão: ficheiro dados.db na raiz do projeto)
# URL_BASE_DADOS=sqlite:///dados.db

# Modo de demonstração: cria faturas de exemplo e desliga a IA (para publicar)
# MODO_DEMO=1
