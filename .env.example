# Copie este ficheiro para .env e preencha os valores.
# O .env está no .gitignore: nunca vai para o repositório.

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo do Claude usado para ler as faturas
MODELO_IA=claude-opus-5-5

# Esforço de raciocínio: low, medium, high (low chega para faturas)
ESFORCO_IA=low

# Base de dados (por omissão: ficheiro dados.db na raiz do projeto).
# Em produção, PostgreSQL (o endereço que o Neon ou o Render mostram; DATABASE_URL também serve):
# URL_BASE_DADOS=postgresql://utilizador:palavra-passe@servidor/base-de-dados?sslmode=require

# Armazenamento dos PDFs e das cópias de segurança (por omissão: pasta uploads/).
# Em produção, um bucket Cloudflare R2 (ou Amazon S3). Basta definir S3_BUCKET para o usar.
# S3_BUCKET=leitor-faturas
# S3_ENDPOINT_URL=https://<id-da-conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Quantas cópias de segurança diárias se guardam
# COPIAS_A_MANTER=30

# Registo de erros no Sentry (opcional) e nome do ambiente
# SENTRY_DSN=
# AMBIENTE=producao

# Modo de demonstração: cria faturas de exemplo e desliga a IA (para publicar)
# MODO_DEMO=1

# Endereço público da aplicação (usado nos links de convite)
URL_PUBLICO=http://127.0.0.1:8000

# SAF-T (PT) da contabilidade: NIF e nome de quem produz o programa.
# Sem valores, o ficheiro usa o NIF e o nome da própria empresa.
SAFT_NIF_PRODUTOR=
SAFT_NOME_PRODUTOR=

# Páginas públicas (/apresentacao, /privacidade, /termos)
EMPRESA_RESPONSAVEL=
EMAIL_COMERCIAL=
# URL_DEMO=https://a-sua-demonstracao.exemplo

# Pagamentos das subscrições (Stripe). Sem STRIPE_SECRET_KEY não há cobranças nem bloqueios.
# Comece com as chaves de teste (sk_test_...) e passe às de produção (sk_live_...) quando estiver tudo certo.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRECO_ESSENCIAL=
STRIPE_PRECO_CONTABILIDADE=
# 1 para o Stripe Tax calcular e acrescentar o IVA (exige o Stripe Tax ativo e o registo de IVA em Portugal)
STRIPE_IVA_AUTOMATICO=

# Faturas certificadas das subscrições (Facturalusa, plano grátis com API). Sem a chave, não se fatura aqui.
FACTURALUSA_API_KEY=
# Opcionais: série (senão, a predefinida), forma de pagamento tal como existe no Facturalusa e referência do artigo
FACTURALUSA_SERIE=
FACTURALUSA_FORMA_PAGAMENTO=
FACTURALUSA_ARTIGO=DOBRA-SUBSCRICAO

# Emails transacionais (Resend). Sem estes valores, os convites são links copiados pelo administrador.
RESEND_API_KEY=
EMAIL_REMETENTE=

# Open banking (ligação direta às contas bancárias) pela Enable Banking. Opcional.
# Registe a aplicação em https://enablebanking.com, com o endereço de regresso URL_PUBLICO/open-banking/retorno.
# Chave privada em PEM (com 
 no lugar das mudanças de linha) ou o caminho do ficheiro .pem.
ENABLE_BANKING_APP_ID=
ENABLE_BANKING_CHAVE_PRIVADA=
# Banco simulado para experimentar sem banco real (ligado sempre na demonstração)
# OPEN_BANKING_SIMULADO=1

# API pública (/api/v1): pedidos por minuto e por chave
# LIMITE_API_POR_MINUTO=300
