# Copie este ficheiro para .env e preencha os valores.
# O .env está no .gitignore: nunca vai para o repositório.

# Chave da API da Anthropic (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Modelo do Claude usado para ler as faturas
MODELO_IA=claude-opus-5-5

# Esforço de raciocínio: low, medium, high (low chega para faturas)
ESFORCO_IA=low

# Base de dados (por omissão: ficheiro dados.db na raiz do projeto).
# Em produção, PostgreSQL (o endereço que o Neon ou o Render mostram; DATABASE_URL também serve):
# URL_BASE_DADOS=postgresql://utilizador:palavra-passe@servidor/base-de-dados?sslmode=require

# Armazenamento dos PDFs e das cópias de segurança (por omissão: pasta uploads/).
# Em produção, um bucket Cloudflare R2 (ou Amazon S3). Basta definir S3_BUCKET para o usar.
# S3_BUCKET=leitor-faturas
# S3_ENDPOINT_URL=https://<id-da-conta>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Quantas cópias de segurança diárias se guardam
# COPIAS_A_MANTER=30

# Registo de erros no Sentry (opcional) e nome do ambiente
# SENTRY_DSN=
# AMBIENTE=producao

# Modo de demonstração: cria faturas de exemplo e desliga a IA (para publicar)
# MODO_DEMO=1

# Endereço público da aplicação (usado nos links de convite)
URL_PUBLICO=http://127.0.0.1:8000
